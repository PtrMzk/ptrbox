#!/usr/bin/env bash
# Stub for macOS `security`. PTRBOX_STUB_TOKEN is the canned Keychain value;
# unset means "no such entry", which is the state on a fresh Mac.
set -euo pipefail
# shellcheck source=tests/stubs/_lib.sh
. "$(dirname "$0")/_lib.sh"

stub_record security "$@"

case "${1:-}" in
  find-generic-password)
    if [ -n "${PTRBOX_STUB_TOKEN:-}" ]; then
      printf '%s\n' "$PTRBOX_STUB_TOKEN"
      exit 0
    fi
    echo "security: SecKeychainSearchCopyNext: The specified item could not be found." >&2
    exit 44
    ;;
  *)
    echo "security stub: unhandled command: ${1:-}" >&2
    exit 64
    ;;
esac
