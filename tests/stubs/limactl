#!/usr/bin/env bash
# Stub for limactl. Canned behaviour driven by:
#   PTRBOX_STUB_VERIFY=ok|fail   what `limactl shell ... verify` reports
#   PTRBOX_STUB_START_FAIL=1     make the first `start` fail
set -euo pipefail
# shellcheck source=tests/stubs/_lib.sh
. "$(dirname "$0")/_lib.sh"

stub_record limactl "$@"

case "${1:-}" in
  list)
    # `limactl list -q` - names only.
    [ -f "$STUB_VMS" ] && cat "$STUB_VMS"
    exit 0
    ;;

  validate)
    [ -f "${2:-}" ] || {
      echo "limactl: no such config: ${2:-}" >&2
      exit 1
    }
    exit 0
    ;;

  start)
    if [ "${PTRBOX_STUB_START_FAIL:-}" = "1" ]; then
      echo "limactl: FATA start failed" >&2
      exit 1
    fi
    if [ "${2:-}" = "--name" ]; then
      # Creation: `limactl start --name X -y --timeout 20m <config>`
      name="$3"
      printf '%s\n' "$name" >>"$STUB_VMS"
      # Lima writes a per-VM ssh config; ptrbox symlinks it.
      mkdir -p "$HOME/.lima/$name"
      printf 'Host lima-%s\n  Hostname 127.0.0.1\n' "$name" \
        >"$HOME/.lima/$name/ssh.config"
    fi
    exit 0
    ;;

  stop)
    exit 0
    ;;

  delete)
    name="${3:-${2:-}}"
    if [ -f "$STUB_VMS" ]; then
      grep -vx "$name" "$STUB_VMS" >"$STUB_VMS.tmp" || true
      mv "$STUB_VMS.tmp" "$STUB_VMS"
    fi
    exit 0
    ;;

  shell)
    # Two callers, told apart by the bash flag in `limactl shell X -- bash …`:
    #   -lc  the verification run; the script is in argv
    #   -c   the token injection; the payload arrives on stdin
    # Deciding on argv rather than `[ -t 0 ]` keeps the stub from ever blocking
    # on a stdin nobody is going to write to.
    if [ "${5:-}" = "-c" ]; then
      stub_capture_stdin
      exit 0
    fi
    if [ "${PTRBOX_STUB_VERIFY:-ok}" = "fail" ]; then
      echo "  sudo removed          FAIL - the agent user still has root" >&2
      exit 1
    fi
    exit 0
    ;;

  *)
    echo "limactl stub: unhandled command: ${1:-}" >&2
    exit 64
    ;;
esac
