#!/usr/bin/env bash
# Stub for Homebrew. PTRBOX_STUB_PREFIX stands in for `brew --prefix`, which
# ptrbox only consults to find leftovers of the old host-squid setup.
set -euo pipefail
# shellcheck source=tests/stubs/_lib.sh
. "$(dirname "$0")/_lib.sh"

stub_record brew "$@"

case "${1:-}" in
  --prefix)
    printf '%s\n' "${PTRBOX_STUB_PREFIX:-/opt/homebrew}"
    ;;
  *)
    echo "brew stub: unhandled command: ${1:-}" >&2
    exit 64
    ;;
esac
