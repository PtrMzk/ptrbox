# =============================================================================
# ptrbox configuration - copy to ~/.config/ptrbox/config and edit.
#
# Plain shell: KEY=value, no exports needed. Every key below can also be set as
# an environment variable of the same name, which overrides the file.
#
# Precedence: built-in defaults < this file < environment.
# =============================================================================

# --- Where repos live --------------------------------------------------------
# A bare `ptrbox new my-api` creates $PTRBOX_REPO_ROOT/my-api. Paths containing
# a slash are used literally and ignore this.
#PTRBOX_REPO_ROOT="$HOME/code"

# --- Guest distro ------------------------------------------------------------
# debian13 (default) or ubuntu2404. Both are apt-based and share package names,
# so provisioning is identical; Debian's cloud image is just smaller and has no
# snap machinery. Anything else needs its own base provisioning script.
#PTRBOX_DISTRO=debian13
#
# Escape hatch: an explicit image URL overrides the distro. Must be https, and
# must be Debian-family or vm/provision/10-base.sh will not find its packages.
#PTRBOX_IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-arm64.qcow2"

# --- Extra guest packages ----------------------------------------------------
# Space-separated apt packages installed into every sandbox VM on top of the
# base list in vm/provision/10-base.sh. Version pins (pkg=1.2-3) are allowed.
# Applies at VM creation: re-create existing VMs to pick up changes.
#
# Host-side on purpose - the list is baked into the generated config by
# `ptrbox new`, never read from inside the VM. A package list under the repo
# mount would let the agent install software into its own sandbox.
#PTRBOX_EXTRA_PACKAGES="ripgrep sqlite3"

# --- VM sizing ---------------------------------------------------------------
# CPUs are only consumed while the VM computes; memory is the one to watch if
# you run several VMs on a 16GB Mac. Disk is sparse - a generous ceiling is
# free, and running out mid-build is not.
#PTRBOX_CPUS=4
#PTRBOX_MEMORY=8GiB
#PTRBOX_DISK=50GiB

# --- Port forwarding ---------------------------------------------------------
# Guest ports in this range are reachable on the Mac's localhost. Covers vite
# (5173), Next/CRA (3000), Flask (5000), Django (8000).
#PTRBOX_PORT_MIN=3000
#PTRBOX_PORT_MAX=9000

# --- Network -----------------------------------------------------------------
# Where a sandbox reaches the egress proxy: Lima usernet's conventional
# gateway address, which the relay delivers to 127.0.0.1 on the Mac - where
# the proxy VM's port forward listens. PROXY_HOST is the only address a
# sandbox may talk to; if `ip route | grep default` inside a VM disagrees,
# change it here.
#PTRBOX_PROXY_HOST=192.168.5.2
#PTRBOX_PROXY_PORT=8888

# The proxy VM itself ("ptrbox-proxy") runs squid and nothing else, so it is
# sized one notch above "obviously enough". Sizing changes apply on the next
# re-creation (limactl delete ptrbox-proxy; any `ptrbox new`/`start` rebuilds
# it).
#PTRBOX_PROXY_CPUS=1
#PTRBOX_PROXY_MEMORY=512MiB
#PTRBOX_PROXY_DISK=4GiB

# DNS resolvers, space separated. Pinned at both the firewall and the guest's
# /etc/resolv.conf: unpinned port-53 egress is a covert exfiltration channel.
# Defaults are Quad9 (which also blocks known-malicious domains) + Cloudflare.
#PTRBOX_DNS_SERVERS="9.9.9.9 1.1.1.1"

# --- Claude Code -------------------------------------------------------------
# Pre-seeded into each VM's ~/.claude/settings.json. "opus" is an alias that
# tracks the latest Opus-class model, so it needs no updating on releases.
#PTRBOX_CLAUDE_MODEL=opus

# macOS Keychain entry holding the OAuth token, created once with:
#   claude setup-token
#   security add-generic-password -a "$USER" -s claude-sandbox-token -w
#PTRBOX_KEYCHAIN_SERVICE=claude-sandbox-token

# --- Git identity for in-VM commits ------------------------------------------
# Defaults to the host's global git config. Set these to commit under a
# different name inside sandboxes.
#PTRBOX_GIT_USER_NAME="Your Name"
#PTRBOX_GIT_USER_EMAIL="you@example.com"

# --- Paths -------------------------------------------------------------------
# The squid access log, as a path INSIDE the proxy VM (read via limactl
# shell). Defaults to Debian's standard location.
#PTRBOX_SQUID_LOG=/var/log/squid/access.log

# Homebrew prefix; auto-detected via `brew --prefix`. Only consulted to find
# leftovers of the old host-squid setup (allowlist migration, retirement
# note).
#PTRBOX_BREW_PREFIX=/opt/homebrew
