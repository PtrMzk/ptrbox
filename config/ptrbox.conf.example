# ptrbox configuration. Every line is commented out and shows the default, so
# this file changes nothing until you uncomment something.
#
#   defaults < ~/.config/ptrbox/config < ~/.config/ptrbox/vms/<vm> < PTRBOX_* env
#
# [vm] keys may also go in a per-VM file; they are frozen into a sandbox at
# create time, so changing one means re-creating that VM. The rest describe
# this Mac and are refused in a per-VM file. Egress is not configured here:
# each VM has ~/.config/ptrbox/allowed_domains.d/<vm>.txt - `ptrbox allow <vm>`.

# --- sandboxes ---------------------------------------------------------------

# Where `ptrbox new my-api` puts a bare name. An argument with a slash wins.
#PTRBOX_REPO_ROOT="$HOME/code"

# [vm] debian13 or ubuntu2404. IMAGE_URL overrides it: https, Debian-family.
#PTRBOX_DISTRO=debian13
#PTRBOX_IMAGE_URL=""

# [vm] Extra apt packages, space separated. Pins (pkg=1.2-3) allowed. Host-side
# on purpose: a list under the repo mount would let the agent choose its own.
#PTRBOX_EXTRA_PACKAGES=""

# [vm] Language runtimes, all off. Claude Code is always installed and needs
# none of them. node = npm/npx and npx-based MCP servers; uv = Python; go =
# the upstream toolchain. Each is more surface, and its own allowlist group.
#PTRBOX_GO=false
#PTRBOX_NODE=false
#PTRBOX_UV=false

# [vm] What `nvm install` gets: lts, node, lts/hydrogen, 22, 22.11.0.
#PTRBOX_NODE_VERSION=lts

# [vm] Sizing. Disk is sparse; memory is the one to watch with several VMs.
#PTRBOX_CPUS=4
#PTRBOX_MEMORY=8GiB
#PTRBOX_DISK=50GiB

# [vm] Guest ports reachable on the Mac's localhost.
#PTRBOX_PORT_MIN=3000
#PTRBOX_PORT_MAX=9000

# [vm] Pre-seeded into the VM's ~/.claude/settings.json.
#PTRBOX_CLAUDE_MODEL=opus

# [vm] In-VM git identity. Empty means your host's global config.
#PTRBOX_GIT_USER_NAME=""
#PTRBOX_GIT_USER_EMAIL=""

# --- this Mac ----------------------------------------------------------------

# Resolvers, pinned in the guest firewall: unpinned port 53 exfiltrates. Not
# per-VM - it is part of that guest's wall.
#PTRBOX_DNS_SERVERS="9.9.9.9 1.1.1.1"

# Keychain entry with the OAuth token. Create it once:
#   claude setup-token
#   security add-generic-password -a "$USER" -s claude-sandbox-token -w
#PTRBOX_KEYCHAIN_SERVICE=claude-sandbox-token

# Where `ptrbox install` offers to symlink the CLI. Declinable.
#PTRBOX_BIN_DIR="$HOME/bin"

# The egress proxy: where a sandbox reaches it (Lima usernet's gateway, which
# relays to 127.0.0.1 on the Mac), and the shared proxy VM's own sizing.
# Sizing applies when the proxy VM is next re-created.
#PTRBOX_PROXY_HOST=192.168.5.2
#PTRBOX_PROXY_PORT=8888
#PTRBOX_PROXY_CPUS=1
#PTRBOX_PROXY_MEMORY=512MiB
#PTRBOX_PROXY_DISK=4GiB

# The squid access log, as a path INSIDE the proxy VM.
#PTRBOX_SQUID_LOG=/var/log/squid/access.log
