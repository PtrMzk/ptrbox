# ptrbox-managed v2
# =============================================================================
# squid.conf - Egress allowlist proxy for ptrbox sandbox VMs.
#
# TEMPLATE. Since v2 this config runs INSIDE the ptrbox-proxy VM, not on the
# Mac: lib/proxy.sh substitutes the double-underscore placeholders and pushes
# the result to /etc/squid/squid.conf in the VM whenever it differs. Do not
# edit the pushed copy - the next sync overwrites it. Structural changes go
# here; domain changes go through `ptrbox allow`.
#
# This proxy is the ONLY path to the internet for the sandbox VMs. Each VM's
# firewall blocks all outbound traffic except to this proxy; Squid then
# permits only domains in allowed_domains.txt.
#
# Squid never decrypts traffic: for HTTPS it sees "CONNECT host:443", checks
# the HOSTNAME against the allowlist, and tunnels the encrypted bytes.
# Domain-based filtering survives the CDN IP churn (PyPI=Fastly,
# npm=Cloudflare) that breaks IP-based allowlists.
#
# Rules evaluate TOP TO BOTTOM, first match wins. Nothing may go below
# "http_access deny all".
# =============================================================================

# Port the sandboxes' proxy env vars and firewall rules point at (via the
# host's 127.0.0.1 forward into this VM).
http_port __PROXY_PORT__

# --- ACL definitions (inert until referenced by http_access) ---
acl SSL_ports port 443                  # standard HTTPS
acl CONNECT method CONNECT              # proxy tunnel requests (how HTTPS transits a proxy)
# Every legitimate request enters through Lima's host port forward, which the
# in-guest agent delivers from loopback - so loopback is the only source this
# proxy serves. (The full path: sandbox dials the Mac's usernet gateway, the
# usernet relay hands it to 127.0.0.1 on the Mac, the forward carries it into
# this VM.) Any process on the Mac can also use the proxy via that forward;
# nothing on the LAN can.
acl from_forward src 127.0.0.1
acl from_forward src ::1
acl allowed_domains dstdomain "/etc/squid/allowed_domains.txt"

# --- Access rules ---
# 1) No tunnels to ports other than 443 - otherwise an allowed domain could be
#    reached on ANY port (ssh/smtp/...), making this a generic TCP relay.
http_access deny CONNECT !SSL_ports
# 2) The allow rule: from the forward AND a CONNECT tunnel (HTTPS) AND an
#    allowlisted destination hostname. (Plain http:// matches nothing here ->
#    falls through to deny. HTTPS-only egress, which every registry/API in
#    the list supports.)
http_access allow from_forward CONNECT allowed_domains
# 3) Default-deny. Everything else -> 403, logged as TCP_DENIED. KEEP LAST.
http_access deny all

# Restarts: don't linger 30s (the default) draining old connections - the VMs'
# tunnels are all retry-safe clients; drop them and come back fast. (Config
# changes restart; allowlist changes go through `squid -k reconfigure`, which
# reloads without dropping anything.)
shutdown_lifetime 1 seconds

# Squid warns without this; the Debian package creates the directory.
coredump_dir /var/spool/squid
